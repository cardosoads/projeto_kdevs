---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
---
<Base title="Página não encontrada · KDevs" noindex>
  <main id="conteudo" class="notfound">
    <div class="wrap">
      <Logo />
      <h1>Esta página não existe</h1>
      <p>O endereço pode ter mudado ou sido digitado com erro.</p>
      <a class="button button--accent" href="/">Voltar ao início</a>
    </div>
  </main>
</Base>
